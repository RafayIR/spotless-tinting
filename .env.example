# Spotless Tinting — environment variables
# Copy values into `.env.local` (local) and Vercel Project Settings → Environment Variables.

# --- Client-safe (Vite exposes VITE_* to the browser bundle) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Google reCAPTCHA v2 (checkbox) — https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# --- Recommended server aliases (set these in Vercel so /api always works) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# --- Server-only (no VITE_ prefix — never import in src/) ---
# Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google reCAPTCHA secret (server only)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Form emails via Resend (https://resend.com) — Contact / Quote / Book / Careers
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=spotlesstinting@gmail.com
# After verifying your domain in Resend, set a real from address:
# CONTACT_FROM_EMAIL=Spotless Tinting <hello@spotlesstinting.com.au>
CONTACT_FROM_EMAIL=Spotless Tinting <onboarding@resend.dev>

# Wix CMS (headless portfolio) — server-only, never add a VITE_ prefix
# Wix Dashboard → Settings → API Keys (permission: Wix Data read items)
WIX_API_KEY=your_wix_api_key
# Site ID: the GUID in your Wix dashboard URL (/dashboard/<site-id>/...)
WIX_SITE_ID=your_wix_site_id
# Optional — defaults to PortfolioProjects
# WIX_PORTFOLIO_COLLECTION=PortfolioProjects
# Optional — form submissions collection ID, defaults to enquiries (key needs write access)
# WIX_ENQUIRIES_COLLECTION=enquiries

REPLICATE_API_TOKEN=your_replicate_api_token
REPLICATE_CAR_SEGMENT_VERSION=your_replicate_model_version_id
